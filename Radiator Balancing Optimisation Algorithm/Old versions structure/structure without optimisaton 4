from __future__ import annotations
from dataclasses import dataclass, field
from typing import List, Optional




# Data classes
@dataclass
class MeasurementRound:
    roundNumber: int
    flowTemp: Optional[float] = None
    returnTemp: Optional[float] = None
    deltaT: Optional[float] = None
    lockshieldPositionAtMeasurement: Optional[float] = None
    adjustmentMadeBeforeMeasurement: Optional[float] = None
    note: str = ""


@dataclass
class Radiator:
    name: str
    orderIndex: Optional[int] = None
    lockshieldPosition: float = 0.0    # 0 = fully open, larger = more closed (can nver go blow 0)
    lastAdjustment: float = 0.0        # positive = closed more, negative = opened more
    measurements: List[MeasurementRound] = field(default_factory=list)


@dataclass
class SystemState:
    projectName: str
    targetDelta: float = 11.0
    radiators: List[Radiator] = field(default_factory=list)
    radiatorOrderKnown: Optional[bool] = None
    heatingAtTemperatureConfirmed: Optional[bool] = None



# Utility functions
def printLine():
    print("\n" + "=" * 60 + "\n")


def pause():
    input("Press Enter to continue...")


def getNonEmptyString(promptText: str) -> str:
    while True:
        value = input(promptText).strip()
        if value:
            return value
        print("Please enter a value")


def getYesNo(promptText: str) -> bool:
    while True:
        value = input(f"{promptText} (y/n): ").strip().lower()
        if value in ["y", "yes"]:
            return True
        if value in ["n", "no"]:
            return False
        print("Enter y or n")


def getPositiveInt(promptText: str) -> int:
    while True:
        value = input(promptText).strip()
        try:
            number = int(value)
            if number > 0:
                return number
            print("Enter a number greater than 0")
        except:
            print("Enter a valid whole number")


def getFloat(promptText: str, minValue: Optional[float] = None) -> float:

    while True:
        value = input(promptText).strip()

        try:
            number = float(value)
            if minValue is not None and number < minValue:
                print(f"Enter a value greater than or equal to {minValue}.")
                continue
            return number
        
        except:
            print("Enter a valid number")


