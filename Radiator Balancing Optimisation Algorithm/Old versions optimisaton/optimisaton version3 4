from __future__ import annotations
from dataclasses import dataclass, asdict, field
from typing import List, Optional
import json




# Data classes
@dataclass
class MeasurementRound:
    roundNumber: int
    flowTemp: Optional[float] = None
    returnTemp: Optional[float] = None
    deltaT: Optional[float] = None
    lockshieldPositionAtMeasurement: Optional[float] = None
    adjustmentMadeBeforeMeasurement: Optional[float] = None
    note: str = ""


@dataclass
class Radiator:
    name: str
    orderIndex: Optional[int] = None
    lockshieldPosition: float = 0.0    # 0 = fully open, larger = more closed (can nver go blow 0)
    lastAdjustment: float = 0.0        # positive = closed more, negative = opened more
    measurements: List[MeasurementRound] = field(default_factory=list)


@dataclass
class SystemState:
    projectName: str
    targetDelta: float = 11.0
    radiators: List[Radiator] = field(default_factory=list)
    radiatorOrderKnown: Optional[bool] = None
    heatingAtTemperatureConfirmed: Optional[bool] = None



# Utility functions
def printLine():
    print("\n" + "=" * 60 + "\n")


def pause():
    input("Press Enter to continue...")


def getNonEmptyString(promptText: str) -> str:
    while True:
        value = input(promptText).strip()
        if value:
            return value
        print("Please enter a value")


def getYesNo(promptText: str) -> bool:
    while True:
        value = input(f"{promptText} (y/n): ").strip().lower()
        if value in ["y", "yes"]:
            return True
        if value in ["n", "no"]:
            return False
        print("Enter y or n")


def getPositiveInt(promptText: str) -> int:
    while True:
        value = input(promptText).strip()
        try:
            number = int(value)
            if number > 0:
                return number
            print("Enter a number greater than 0")
        except:
            print("Enter a valid whole number")


def getFloat(promptText: str, minValue: Optional[float] = None) -> float:

    while True:
        value = input(promptText).strip()

        try:
            number = float(value)
            if minValue is not None and number < minValue:
                print(f"Enter a value greater than or equal to {minValue}.")
                continue
            return number
        
        except:
            print("Enter a valid number")


def round1(value: float) -> float:
    return round(value, 1)

def round3(value: float) -> float:
    return round(value, 3)


def calculateDeltaT(flowTemp: float, returnTemp: float) -> float:
    return round1(flowTemp - returnTemp)



def getDeltaStatus(deltaT: float, targetDelta: float) -> str:
    lowerBound = targetDelta - 1.0
    upperBound = targetDelta + 1.0

    if lowerBound <= deltaT <= upperBound:
        return "Within target range"
    
    elif deltaT < lowerBound:
        return "Too low. The radiator has too much flow, needs more locksheild restriction"
    else:
        return "Too high. The radiator has too little flow, needs less locksheild restriction"


def isBalanced(deltaT: float, targetDelta: float) -> bool:
    return (targetDelta - 1.0) <= deltaT <= (targetDelta + 1.0)


def getSortedRadiators(state: SystemState) -> List[Radiator]:
    return sorted(state.radiators,key=lambda radiator: radiator.orderIndex if radiator.orderIndex is not None else 9999)


def getNextRoundNumber(state: SystemState) -> int:
    highestRound = 0

    for radiator in state.radiators:
        for measurement in radiator.measurements:

            if measurement.roundNumber > highestRound:
                highestRound = measurement.roundNumber

    return highestRound + 1


# Save and load projects
def saveProject(state: SystemState, fileName: str = "radiatorBalancingData.json"):
    with open(fileName, "w", encoding="utf-8") as file:
        json.dump(asdict(state), file, indent=4)

    print(f"Project saved to {fileName}")


def loadProject(fileName: str = "radiatorBalancingData.json") -> Optional[SystemState]:
    try:
        with open(fileName, "r", encoding="utf-8") as file:
            data = json.load(file)

        radiators = []

        for radiatorData in data.get("radiators", []):
            measurements = []

            for measurementData in radiatorData.get("measurements", []):
                measurements.append(
                    MeasurementRound(
                        roundNumber=measurementData.get("roundNumber"),
                        flowTemp=measurementData.get("flowTemp"),
                        returnTemp=measurementData.get("returnTemp"),
                        deltaT=measurementData.get("deltaT"),
                        lockshieldPositionAtMeasurement=measurementData.get("lockshieldPositionAtMeasurement"),
                        adjustmentMadeBeforeMeasurement=measurementData.get("adjustmentMadeBeforeMeasurement", 0.0),
                        note=measurementData.get("note", "")))


            radiator = Radiator(
                name=radiatorData.get("name", "Unnamed"),
                orderIndex=radiatorData.get("orderIndex"),
                lockshieldPosition=radiatorData.get("lockshieldPosition", 0.0),
                lastAdjustment=radiatorData.get("lastAdjustment", 0.0),
                measurements=measurements)
            
            radiators.append(radiator)

        state = SystemState(
            projectName=data.get("projectName", "Loaded Project"),
            targetDelta=data.get("targetDelta", 11.0),
            radiators=radiators,
            radiatorOrderKnown=data.get("radiatorOrderKnown"),
            heatingAtTemperatureConfirmed=data.get("heatingAtTemperatureConfirmed"))

        return state


    except FileNotFoundError:
        print("Project could not be found")
        return None
    
    except:
        print(f"Error loading project: ")
        return None


