# Creating a new system
def createNewSystem() -> SystemState:
    printLine()
    print("Add a new heating system")

    showBleedTip()

    projectName = getNonEmptyString("Enter the name of the system or building: ")
    targetDelta = getFloat("Enter target delta T in degrees C (recommended 11 if unsure): ", minValue=0)

    state = SystemState(projectName=projectName, targetDelta=targetDelta)
    print(f"\nProject '{projectName}' created\n")

    showColdSystemTip()

    print("Would you like to:")
    print("1. Continue and input the radiators")
    print("2. Return to the main menu")

    choice = getPositiveInt("Choose an option: ")

    if choice == 1:
        addRadiators(state)

    return state



def addRadiators(state: SystemState):
    printLine()
    print("Radiator Setup")

    radiatorCount = getPositiveInt("How many radiators are in the system? ")

    state.radiators = []

    for i in range(radiatorCount):
        radiatorName = getNonEmptyString(f"Enter name for radiator {i + 1}: ")
        radiator = Radiator(
            name=radiatorName,
            lockshieldPosition=0.0,
            lastAdjustment=0.0)
        
        state.radiators.append(radiator)

    print("\nRadiators added successfully.\n")

    showValveSetupTip()

    print("Would you like to:")
    print("1. Continue and set the radiator order")
    print("2. Return to the main menu")

    choice = getPositiveInt("Choose an option: ")

    if choice == 1:
        setRadiatorOrder(state)



def setRadiatorOrder(state: SystemState):
    printLine()
    print("Radiator Order")
    print("Radiators need to be ordered from closest to the boiler to furthest")

    state.radiatorOrderKnown = getYesNo("Do you already know the radiator order relative to the boiler")

    if not state.radiatorOrderKnown:
        showOrderDiscoveryTips()
        input("When you are ready, press Enter to input the order...")


    print()
    print("Available radiators:")
    for index, radiator in enumerate(state.radiators, start=1):
        print(f" {index}. {radiator.name}")



    print()
    print("Enter each radiator name in order from closest to the boiler to furthest")

    remainingNames = [radiator.name for radiator in state.radiators]
    orderedNames = []

    for position in range(1, len(state.radiators) + 1):

        while True:
            chosenName = getNonEmptyString(f"Radiator at position {position}: ")
            matchedName = None

            for name in remainingNames:
                if name.lower() == chosenName.lower():
                    matchedName = name
                    break

            if matchedName is None:
                print("Radiator not found. Try again.")

            else:
                orderedNames.append(matchedName)
                remainingNames.remove(matchedName)
                break


    for orderIndex, radiatorName in enumerate(orderedNames, start=1):
        for radiator in state.radiators:
            if radiator.name == radiatorName:
                radiator.orderIndex = orderIndex
                break

    print("\nRadiators ordered successfully\n")

    print()
    print("Would you like to:")
    print("1. Continue and enter the first round of measurements")
    print("2. Return to the main menu")

    choice = getPositiveInt("Choose an option: ")

    if choice == 1:
        roundNumber = getNextRoundNumber(state)
        enterMeasurementRound(state, roundNumber)


# Taking measurements
def enterMeasurementRound(state: SystemState, roundNumber: int):
    printLine()
    print(f"Measurements Round {roundNumber}")
    print(f"Target delta T: {state.targetDelta} degrees C")
    showHeatingRunTips()
    print("Measure both sides of each radiator with your thermometer")
    print("The program will work out which side is flow and which is return")

    sortedRadiators = getSortedRadiators(state)


    for radiator in sortedRadiators:
        printLine()
        print(f"Radiator: {radiator.name}")

        if radiator.orderIndex is not None:
            print(f"Order from boiler: {radiator.orderIndex}")


        temp1 = getFloat("Temperature of one side in degrees C: ")
        temp2 = getFloat("Temperature of the other side in degrees C: ")

        if temp1 >= temp2:
            flowTemp = temp1
            returnTemp = temp2

        else:
            flowTemp = temp2
            returnTemp = temp1

        deltaT = calculateDeltaT(flowTemp, returnTemp)

        print(f"Flow: {round1(flowTemp)} C   Return: {round1(returnTemp)} C   Delta T: {deltaT} C")
        print(f"Status: {getDeltaStatus(deltaT, state.targetDelta)}")

        measurement = MeasurementRound(
            roundNumber=roundNumber,
            flowTemp=round1(flowTemp),
            returnTemp=round1(returnTemp),
            deltaT=deltaT,
            lockshieldPositionAtMeasurement=round3(radiator.lockshieldPosition),
            adjustmentMadeBeforeMeasurement=round3(radiator.lastAdjustment))
        
        radiator.measurements.append(measurement)


    adjustments, carryOver = optimisationMatrix(state.radiators, state.targetDelta)

    for radiator, adjustment in zip(sortedRadiators, adjustments):
        radiator.lockshieldPosition = roundToQuarterTurn(radiator.lockshieldPosition + adjustment)
        radiator.lastAdjustment = adjustment

    print()
    printLine()
    print()
    print(f"Carry over effect: {carryOver}") # testing
    print("Suggested adjustments:")
    for radiator, adjustment in zip(sortedRadiators, adjustments):
        print(f"{radiator.name}: {adjustment:+.2f} turns")


def roundToQuarterTurn(value: float) -> float:
    return round(value * 4) / 4


def turnsPerDegree(deltaT: float, targetDeltaT: float) -> float:
    deltaError = deltaT - targetDeltaT
    turns = -((deltaError * abs(deltaError)) / 8)
    return roundToQuarterTurn(turns)


def buildCarryOverList( # unused
    sourceIndex: int,
    appliedAdjustment: float,
    radiatorCount: int,
    learningRate: float
) -> List[float]:
    """
    Creates the effect list for radiators after the one just changed.

    Opposite sign to the change:
    - if this radiator is opened more (-), later radiators tend to need closing more (+)
    - if this radiator is closed more (+), later radiators tend to need opening more (-)

    Effect decreases non-linearly with distance and also scales down a for larger systems
    """
    carryOver = [0.0] * radiatorCount

    if appliedAdjustment == 0:
        return carryOver

    systemScale = max(1.0, radiatorCount ** 0.5)
    baseEffect = (-appliedAdjustment * learningRate) / systemScale

    for i in range(sourceIndex + 1, radiatorCount):
        distance = i - sourceIndex
        effect = baseEffect / (distance ** 1.35)
        carryOver[i] = roundToQuarterTurn(effect)

    return carryOver


def addCarryOverLists(currentList: List[float], newList: List[float]) -> List[float]: # unused
    combined = []

    for currentValue, newValue in zip(currentList, newList):
        combined.append(roundToQuarterTurn(currentValue + newValue))

    return combined


def limitAdjustmentToValveRange(currentPosition: float, requestedAdjustment: float) -> float:
    newPosition = currentPosition + requestedAdjustment

    if newPosition < 0:
        return roundToQuarterTurn(-currentPosition)

    return roundToQuarterTurn(requestedAdjustment)


def optimisationMatrix(
    radiators: List["Radiator"],
    targetDeltaT: float,
    learningRate: float = 0.5) -> tuple[List[float], List[float]]:

    sortedRadiators = sorted(
        radiators,
        key=lambda radiator: radiator.orderIndex if radiator.orderIndex is not None else 9999)

    radiatorCount = len(sortedRadiators)


    directAdjustments = [0.0] * radiatorCount
    carryOverAdjustment = [0.0] * radiatorCount

    for i, radiator in enumerate(sortedRadiators):

        if not radiator.measurements:
            directAdjustments[i] = 0.0
            continue

        latestMeasurement = radiator.measurements[-1]

        if latestMeasurement.deltaT is None:
            directAdjustments[i] = 0.0
            continue

        if abs(latestMeasurement.deltaT - targetDeltaT) <= 1:
            baseAdjustment = 0.0
        else:
            baseAdjustment = turnsPerDegree(latestMeasurement.deltaT, targetDeltaT)

        currentPosition = radiator.lockshieldPosition
        appliedDirectAdjustment = limitAdjustmentToValveRange(currentPosition, baseAdjustment)

        directAdjustments[i] = appliedDirectAdjustment

        # If the radiator needs more opening than  possible we split the unmet opening equally across all other radiators as extra closing
        if baseAdjustment < 0 and appliedDirectAdjustment > baseAdjustment:
            unmetOpening = roundToQuarterTurn(abs(baseAdjustment - appliedDirectAdjustment))

            otherRadiatorCount = radiatorCount - 1

            if otherRadiatorCount > 0:
                carryPerOtherRadiator = roundToQuarterTurn(unmetOpening / otherRadiatorCount)

                for j in range(radiatorCount):
                    if j != i:
                        carryOverAdjustment[j] = roundToQuarterTurn(
                            carryOverAdjustment[j] + carryPerOtherRadiator)

    finalAdjustments = [0.0] * radiatorCount

    for i, radiator in enumerate(sortedRadiators):
        totalAdjustment = roundToQuarterTurn(directAdjustments[i] + carryOverAdjustment[i])
        finalAdjustments[i] = limitAdjustmentToValveRange(
            radiator.lockshieldPosition,
            totalAdjustment)

    return finalAdjustments, carryOverAdjustment



# Show results 
def showLatestResults(state: SystemState):
    printLine()
    print("Latest Results")

    if not state.radiators:
        print("No radiators found")
        return

    sortedRadiators = getSortedRadiators(state)
    latestRoundNumber = getNextRoundNumber(state) - 1

    if latestRoundNumber < 1:
        print("No measurement round recorded")
        return

    print(f"Latest round: {latestRoundNumber}")
    print(f"Target delta T: {state.targetDelta} degrees C")
    print()

    for radiator in sortedRadiators:
        print(f"Radiator: {radiator.name}")

        if radiator.orderIndex is not None:
            print(f"Order: {radiator.orderIndex}")

        if not radiator.measurements:
            print("No measurements recorded")
            print()
            continue

        latestMeasurement = radiator.measurements[-1]

        print(f"Flow temperature: {latestMeasurement.flowTemp} C")
        print(f"Return temperature: {latestMeasurement.returnTemp} C")
        print(f"Delta T: {latestMeasurement.deltaT} C")
        print(f"Status: {getDeltaStatus(latestMeasurement.deltaT, state.targetDelta)}")
        print(f"Lockshield position at measurement: {latestMeasurement.lockshieldPositionAtMeasurement}")
        print(f"Adjustment made before measurement: {latestMeasurement.adjustmentMadeBeforeMeasurement}")
        print(f"Current lockshield position: {round3(radiator.lockshieldPosition)}")
        print(f"Latest suggested / applied adjustment: {round3(radiator.lastAdjustment)}")
        print()




def showFullProjectSummary(state: SystemState):
    printLine()
    print("Project Summary")
    print(f"Project name: {state.projectName}")
    print(f"Target delta T: {state.targetDelta} degrees C")
    print(f"Number of radiators: {len(state.radiators)}")
    print(f"Radiator order: {state.radiatorOrderKnown}")
    print()

    sortedRadiators = getSortedRadiators(state)

    for radiator in sortedRadiators:
        print(f"Radiator: {radiator.name}")
        print(f"Order: {radiator.orderIndex}")
        print(f"Lockshield position: {round3(radiator.lockshieldPosition)}")
        print(f"Measurement rounds recorded: {len(radiator.measurements)}")

        for measurement in radiator.measurements:
            print(
                f"Round {measurement.roundNumber}: "
                f"Tf={measurement.flowTemp} C, "
                f"Tr={measurement.returnTemp} C, "
                f"DeltaT={measurement.deltaT} C, "
                f"Lockshield={measurement.lockshieldPositionAtMeasurement}, "
                f"PrevAdjustment={measurement.adjustmentMadeBeforeMeasurement}")
        
        print()


# Menu
def showMenu():
    printLine()
    print("Main Menu")
    print("1. Add a new heating system")
    print("2. Continue with a saved heating system")
    print("3. Enter a measurement round")
    print("4. Show latest results")
    print("5. Show full project summary")
    print("6. Save project")
    print("0. Exit")
    printLine()


def main():
    state = None

    while True:
        showMenu()
        choice = input("Choose an option: ").strip()

        if choice == "1":
            state = createNewSystem()

        elif choice == "2":
            loadedState = loadProject()
            if loadedState is not None:
                state = loadedState
                print("Project loaded successfully")

                if not state.radiators:
                    addRadiators(state)
                elif any(radiator.orderIndex is None for radiator in state.radiators):
                    setRadiatorOrder(state)

        elif choice == "3":
            if state is None:
                print("Create or load a project first")
            elif not state.radiators:
                print("You need to add radiators first")
            else:
                roundNumber = getNextRoundNumber(state)
                enterMeasurementRound(state, roundNumber)

        elif choice == "4":
            if state is None:
                print("Create or load a project first")
            else:
                showLatestResults(state)


        elif choice == "5":
            if state is None:
                print("Create or load a project first")
            else:
                showFullProjectSummary(state)

        elif choice == "6":
            if state is None:
                print("Create or load a project first")
            else:
                saveProject(state)

        elif choice == "0":
            if state is not None:
                if getYesNo("Would you like to save before exiting"):
                    saveProject(state)
            print("Bye :)")
            break

        else:
            print("Invalid option. Try again")


        pause()


if __name__ == "__main__":
    main()